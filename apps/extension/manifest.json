{
  "manifest_version": 3,
  "name": "Browser Tracker Cleaner",
  "version": "0.1.0",
  "description": "Blocks known browser trackers locally.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easyprivacy_rules_1",
        "enabled": true,
        "path": "rules/easyprivacy-1.json"
      },
      {
        "id": "easyprivacy_rules_2",
        "enabled": true,
        "path": "rules/easyprivacy-2.json"
      }
    ]
  },
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Tracker Cleaner",
    "default_popup": "popup.html"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackers",
  "version": "0.1.0",
  "identifier": "com.sachinkshetty.trackers",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trackers",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"]
  }
}
